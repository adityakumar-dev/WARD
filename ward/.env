# WARD Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Inference Mode ──────────────────────────────────────────────────────────
# "dev"  → local GPU inference (downloads HF models to disk)
# "prod" → Hugging Face Inference Endpoints
WARD_MODE=dev

# ── Model IDs (DEV only) ────────────────────────────────────────────────────
ORIGINAL_MODEL_ID=adityakumarxdev/ward-siglip
FINE_MODEL_ID=adityakumarxdev/ward-siglip-lora-2

# ── Fusion Weights ───────────────────────────────────────────────────────────
ORIGINAL_WEIGHT=0.30
FINE_WEIGHT=0.70

# ── Frame Processing ─────────────────────────────────────────────────────────
INFERENCE_FPS=5
FRAME_QUEUE_SIZE=2

# ── Temporal Engine ──────────────────────────────────────────────────────────
PREDICTION_HISTORY_SIZE=20
EMA_ALPHA=0.40
SWITCH_MARGIN=0.10
MIN_CANDIDATE_STREAK=3
MIN_STATE_DWELL_SECONDS=2.0
STRONG_OVERRIDE_THRESHOLD=0.90
AMBIGUITY_THRESHOLD=0.10

# ── Weather ──────────────────────────────────────────────────────────────────
WEATHER_REFRESH_SECONDS=300

# ── Production Endpoints (PROD only) ─────────────────────────────────────────
HF_TOKEN=
HF_ORIGINAL_ENDPOINT=
HF_FINE_ENDPOINT=
